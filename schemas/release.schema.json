{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://riccon.dev/schemas/release.schema.json",
  "title": "Riccon 发布记录",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "environment",
    "scope",
    "status",
    "risk_tier",
    "artifacts",
    "evidence",
    "created_at"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^REL-[0-9]{4,}$" },
    "version": { "type": "string", "minLength": 1 },
    "environment": { "enum": ["sandbox", "staging", "production"] },
    "scope": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["draft", "approved", "released", "rolled_back", "blocked"]
    },
    "risk_tier": { "enum": ["T1", "T2", "T3", "T4"] },
    "artifacts": {
      "type": "object",
      "required": ["threat_model", "load_test", "rollback_drill", "runbook"],
      "additionalProperties": true,
      "properties": {
        "threat_model": { "type": "string" },
        "load_test": { "type": "string" },
        "rollback_drill": { "type": "string" },
        "runbook": { "type": "string" }
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "by",
        "decision_id",
        "release_id",
        "environment",
        "answer_kind",
        "answer_sha256",
        "approved_at"
      ],
      "additionalProperties": true,
      "properties": {
        "by": { "enum": ["user"] },
        "decision_id": { "type": "string" },
        "release_id": { "type": "string", "pattern": "^REL-[0-9]{4,}$" },
        "environment": { "enum": ["sandbox", "staging", "production"] },
        "answer_kind": { "enum": ["approve"] },
        "answer_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "release_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "second_review": {
          "type": "object",
          "required": ["model", "review_id", "review_path", "review_sha256", "verdict", "evidence"],
          "additionalProperties": true,
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "review_id": { "type": "string", "minLength": 1 },
            "review_path": { "type": "string", "minLength": 1 },
            "review_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "reviewer_agent": { "type": ["string", "null"] },
            "reviewer_session": { "type": ["string", "null"] },
            "verdict": { "enum": ["pass", "fail"] },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          }
        },
        "approved_at": { "type": "string" }
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
