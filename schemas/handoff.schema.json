{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://riccon.dev/schemas/handoff.schema.json",
  "title": "Riccon 交接",
  "type": "object",
  "required": [
    "handoff_id",
    "session",
    "summary",
    "next",
    "invariants",
    "risks",
    "first_read",
    "created_at"
  ],
  "additionalProperties": true,
  "properties": {
    "handoff_id": {
      "type": "string",
      "pattern": "^HANDOFF-[0-9]{4,}$"
    },
    "session": { "type": ["string", "null"] },
    "summary": { "type": "string" },
    "next": { "type": "string" },
    "invariants": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "first_read": { "type": "array", "items": { "type": "string" } },
    "quality_gate": {
      "type": "object",
      "required": ["status", "gate_status", "active_tasks", "checked_at"],
      "additionalProperties": true,
      "properties": {
        "status": { "enum": ["pass"] },
        "gate_status": { "enum": ["none", "pass", "fail"] },
        "gate_module_id": { "type": ["string", "null"] },
        "gate_checked_at": { "type": ["string", "null"] },
        "release_gate_status": { "enum": ["none", "pass", "fail"] },
        "product_acceptance_open": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "active_tasks": { "type": "integer", "minimum": 0 },
        "checked_at": { "type": "string" }
      }
    },
    "created_at": { "type": "string" }
  }
}
