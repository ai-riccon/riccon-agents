{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://riccon.dev/schemas/review.schema.json",
  "title": "Riccon 模块评审",
  "type": "object",
  "required": [
    "review_id",
    "module_id",
    "verifier",
    "verdict",
    "dod",
    "findings",
    "created_at"
  ],
  "additionalProperties": true,
  "properties": {
    "review_id": { "type": "string", "minLength": 1 },
    "module_id": { "type": "string", "minLength": 1 },
    "verifier": { "type": "string", "minLength": 1 },
    "reviewer": {
      "type": "object",
      "required": ["agent", "session", "model", "independent"],
      "additionalProperties": true,
      "properties": {
        "agent": { "type": "string", "minLength": 1 },
        "session": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "independent": { "type": "boolean" }
      }
    },
    "reviewed_evidence": {
      "type": "array",
      "items": { "type": "string", "pattern": "^EV-[0-9]{4,}$" }
    },
    "release_id": {
      "type": ["string", "null"],
      "pattern": "^REL-[0-9]{4,}$"
    },
    "version": { "type": ["string", "null"] },
    "environment": {
      "type": ["string", "null"],
      "enum": ["sandbox", "staging", "production", null]
    },
    "review_kind": { "type": ["string", "null"] },
    "verdict": { "enum": ["pass", "fail", "blocked"] },
    "dod": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "dod_evidence": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "pattern": "^EV-[0-9]{4,}$" },
          {
            "type": "array",
            "items": { "type": "string", "pattern": "^EV-[0-9]{4,}$" }
          }
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "title", "status"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["P0", "P1", "P2", "P3"] },
          "title": { "type": "string" },
          "status": { "enum": ["open", "fixed", "accepted"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "created_at": { "type": "string" }
  }
}
