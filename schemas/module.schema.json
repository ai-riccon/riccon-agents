{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://riccon.dev/schemas/module.schema.json",
  "title": "Riccon 交付模块",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "goal",
    "status",
    "depends_on",
    "acceptance",
    "tasks",
    "review",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^M[0-9]{2,}$" },
    "title": { "type": "string", "minLength": 1 },
    "goal": { "type": "string" },
    "kind": { "enum": ["mvc", "feature", "fix"] },
    "status": {
      "enum": [
        "planned",
        "building",
        "verifying",
        "review_pending",
        "done",
        "blocked"
      ]
    },
    "blocker": { "type": ["string", "null"] },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "acceptance": { "type": "array", "items": { "type": "string" } },
    "tasks": { "type": "array", "items": { "type": "string" } },
    "review": { "type": ["string", "null"] },
    "fixes_module": {
      "type": ["string", "null"],
      "pattern": "^M[0-9]{2,}$"
    },
    "split_from": {
      "type": ["string", "null"],
      "pattern": "^M[0-9]{2,}$"
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "product_acceptance": {
      "type": ["object", "null"],
      "required": ["product_status", "user_status"],
      "additionalProperties": true,
      "properties": {
        "product_status": {
          "enum": [
            "not-recorded",
            "pending",
            "pass",
            "changes-requested",
            "blocked"
          ]
        },
        "user_status": {
          "enum": [
            "not-recorded",
            "pending",
            "accepted",
            "rejected",
            "conditional"
          ]
        },
        "decision_id": { "type": ["string", "null"] },
        "ref": { "type": ["string", "null"] },
        "note": { "type": "string" },
        "accepted_at": { "type": ["string", "null"] },
        "updated_at": { "type": ["string", "null"] }
      }
    },
    "wall_clock_limit_hours": { "type": "number", "exclusiveMinimum": 0 },
    "started_at": { "type": ["string", "null"] },
    "finished_at": { "type": ["string", "null"] },
    "budget_usage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "requests": { "type": "number", "minimum": 0 },
        "tokens_input": { "type": "number", "minimum": 0 },
        "tokens_output": { "type": "number", "minimum": 0 },
        "wall_clock_minutes": { "type": "number", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "confidence": { "enum": ["unmeasured", "estimated", "measured"] },
        "source": { "type": "string" },
        "note": { "type": "string" },
        "recorded_at": { "type": "string" }
      }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
